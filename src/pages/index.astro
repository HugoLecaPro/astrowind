---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Clinician Vision',
  ignoreTitleTemplate: true,
};

const chapters = [
  {
    id: '01',
    label: 'Clinical tension',
    title: 'Open with pressure, not product.',
    copy: 'The first scroll beat should feel like a lived environment: pressure, density, decisions, and constrained attention.',
    detail: 'This prototype uses spacing, contrast, and sticky sequencing to create that initial sense of gravity.',
  },
  {
    id: '02',
    label: 'Orchestration',
    title: 'Let the page choreograph the argument.',
    copy: 'Rather than stacking generic sections, the page now moves through deliberate chapters, each with its own pacing and visual emphasis.',
    detail:
      'The sticky rail responds as the user scrolls, giving the layout a narrative spine even before real content arrives.',
  },
  {
    id: '03',
    label: 'Signal',
    title: 'Use visuals as confidence cues.',
    copy: 'Investors do not need decoration. They need composure, sharp hierarchy, and signs that the team can present complexity cleanly.',
    detail: 'The dashboard-like surfaces and motion layers are placeholders for future product or market visuals.',
  },
  {
    id: '04',
    label: 'Conviction',
    title: 'End in a calm, high-trust frame.',
    copy: 'The final sections should feel less like a landing page and more like the closing movement of a vision deck translated to the web.',
    detail: 'This shell is now ready for sharper narrative copy, proof points, and differentiated clinical insight.',
  },
];
---

<Layout metadata={metadata}>
  <div class="vision-page">
    <section id="top" class="vision-hero">
      <div class="vision-halo vision-halo-a"></div>
      <div class="vision-halo vision-halo-b"></div>
      <div class="vision-grain"></div>

      <div class="vision-shell">
        <div class="vision-copy">
          <p class="vision-kicker">Narrative Prototype</p>
          <h1>
            Designing the shell for a
            <span>clinician-first investor story</span>
          </h1>
          <p class="vision-lede">
            This version focuses only on atmosphere, pacing, layout, and interaction. The goal is to make the site feel
            intentional, premium, and scroll-led before real claims and real proof are inserted.
          </p>

          <div class="vision-actions">
            <a class="vision-button vision-button-primary" href="#story">Begin the sequence</a>
            <a class="vision-button vision-button-secondary" href="#atmosphere">View the design system</a>
          </div>

          <div class="vision-statbar">
            <div class="vision-statcard">
              <span class="vision-statlabel">Tone</span>
              <strong>Editorial calm</strong>
            </div>
            <div class="vision-statcard">
              <span class="vision-statlabel">Motion</span>
              <strong>Scroll-reactive</strong>
            </div>
            <div class="vision-statcard">
              <span class="vision-statlabel">Audience</span>
              <strong>Clinician investors</strong>
            </div>
          </div>
        </div>

        <div class="vision-stage-wrap">
          <div class="vision-stage" data-hero-stage>
            <div class="vision-stage-grid"></div>
            <div class="vision-stage-beam" data-parallax="10"></div>
            <div class="vision-stage-ring vision-stage-ring-a" data-parallax="-18"></div>
            <div class="vision-stage-ring vision-stage-ring-b" data-parallax="14"></div>

            <div class="vision-floatcard vision-floatcard-a" data-parallax="18">
              <span class="vision-pill">Scene</span>
              <strong>Signal density</strong>
              <p>Layered cues imply complexity without asking the user to read too early.</p>
            </div>

            <div class="vision-floatcard vision-floatcard-b" data-parallax="-12">
              <span class="vision-pill vision-pill-alt">Motion</span>
              <strong>Soft tracking</strong>
              <p>Pointer drift and scroll-state changes add life while staying restrained.</p>
            </div>

            <div class="vision-dashboard" data-parallax="7">
              <div class="vision-dashboard-top">
                <span>Clinical workflow model</span>
                <span>Layer 01</span>
              </div>

              <div class="vision-dashboard-main">
                <div class="vision-dashboard-column">
                  <div class="vision-mini-panel">
                    <span class="vision-mini-label">Narrative arc</span>
                    <div class="vision-wave">
                      <span></span><span></span><span></span><span></span><span></span>
                    </div>
                  </div>
                  <div class="vision-mini-panel vision-mini-panel-dark">
                    <span class="vision-mini-label">Trust cues</span>
                    <div class="vision-bars">
                      <span></span><span></span><span></span><span></span>
                    </div>
                  </div>
                </div>

                <div class="vision-dashboard-column vision-dashboard-center">
                  <div class="vision-orbit">
                    <span class="vision-orbit-core"></span>
                    <span class="vision-orbit-node vision-node-a"></span>
                    <span class="vision-orbit-node vision-node-b"></span>
                    <span class="vision-orbit-node vision-node-c"></span>
                  </div>
                </div>
              </div>

              <div class="vision-dashboard-footer">
                <div>
                  <span class="vision-mini-label">Pacing</span>
                  <strong>Deliberate</strong>
                </div>
                <div>
                  <span class="vision-mini-label">Presentation</span>
                  <strong>High-trust</strong>
                </div>
              </div>
            </div>
          </div>

          <a class="vision-scrollcue" href="#story">
            <span></span>
            Scroll to move through the chapters
          </a>
        </div>
      </div>
    </section>

    <section id="story" class="vision-story">
      <div class="vision-container">
        <div class="vision-section-head">
          <p class="vision-section-kicker">Scroll-led structure</p>
          <h2>The page now behaves like a guided sequence.</h2>
          <p>
            The content is still provisional, but the layout already creates a progression: setup, movement, signal, and
            landing. That matters when the product itself is still a vision.
          </p>
        </div>

        <div class="vision-story-grid">
          <div class="vision-rail-column">
            <div class="vision-rail-card" data-story-visual data-active-stage="01">
              <div class="vision-rail-topline">
                <span class="vision-pill">Sticky visual</span>
                <span>Scroll state</span>
              </div>

              <div class="vision-rail-display">
                <div class="vision-rail-line"></div>
                {
                  chapters.map((chapter, index) => (
                    <div class="vision-stage-stop" data-stage-stop={chapter.id} style={`--stop-index:${index + 1}`}>
                      <span>{chapter.id}</span>
                      <small>{chapter.label}</small>
                    </div>
                  ))
                }

                <div class="vision-stage-panels">
                  {
                    chapters.map((chapter) => (
                      <div class="vision-stage-panel" data-stage-panel={chapter.id}>
                        <span class="vision-stage-panel-id">{chapter.id}</span>
                        <h3>{chapter.title}</h3>
                        <p>{chapter.copy}</p>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <div class="vision-chapter-column">
            {
              chapters.map((chapter) => (
                <article class="vision-chapter" data-stage-card={chapter.id}>
                  <div class="vision-chapter-panel">
                    <div class="vision-chapter-index">{chapter.id}</div>
                    <div class="vision-chapter-copy">
                      <p class="vision-chapter-label">{chapter.label}</p>
                      <h3>{chapter.title}</h3>
                      <p>{chapter.copy}</p>
                      <p>{chapter.detail}</p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="atmosphere" class="vision-atmosphere">
      <div class="vision-container">
        <div class="vision-section-head vision-section-head-light">
          <p class="vision-section-kicker">Aesthetic building blocks</p>
          <h2>Four easy tricks that make the prototype feel more credible.</h2>
          <p>
            Depth, editorial typography, sticky sequencing, and visual surfaces do more here than placeholder copy ever
            could.
          </p>
        </div>

        <div class="vision-bento">
          <article class="vision-tile vision-tile-large">
            <span class="vision-tile-label">Layering</span>
            <h3>Soft glass, not glossy noise.</h3>
            <p>
              Partial transparency, blur, and radial highlights create separation without turning the page into a toy.
            </p>
            <div class="vision-scanfield">
              <span></span><span></span><span></span>
            </div>
          </article>

          <article class="vision-tile vision-tile-tall">
            <span class="vision-tile-label">Typography</span>
            <h3>Serif headlines carry conviction.</h3>
            <p>
              A serif display for the main statements and a quiet sans for support copy instantly removes the template
              feel.
            </p>
          </article>

          <article class="vision-tile">
            <span class="vision-tile-label">Scroll</span>
            <h3>Sticky sections guide attention.</h3>
            <p>
              The rail stays in view while chapters pass, which makes the narrative feel authored rather than stacked.
            </p>
          </article>

          <article class="vision-tile vision-tile-accent">
            <span class="vision-tile-label">Motion</span>
            <h3>Micro-interaction over spectacle.</h3>
            <p>
              Pointer drift, subtle pulsing, and scroll-state changes keep the page alive without undermining trust.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="status" class="vision-status">
      <div class="vision-container">
        <div class="vision-status-panel">
          <div class="vision-status-copy">
            <p class="vision-section-kicker">Prototype chassis</p>
            <h2>The visual language is now strong enough to receive real proof later.</h2>
            <p>
              The next pass does not need more effects. It needs sharper claims, product screenshots, clinical workflow
              diagrams, and evidence arranged inside this structure.
            </p>
          </div>

          <div class="vision-status-meters">
            <div class="vision-meter">
              <span>Story pacing</span>
              <strong>82%</strong>
            </div>
            <div class="vision-meter">
              <span>Visual trust</span>
              <strong>76%</strong>
            </div>
            <div class="vision-meter">
              <span>Motion restraint</span>
              <strong>91%</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="finale" class="vision-finale">
      <div class="vision-container">
        <div class="vision-finale-panel">
          <p class="vision-section-kicker">Ready for content</p>
          <h2>A better stage for the real story.</h2>
          <p>
            This homepage is no longer a basic template swap. It is now a design-led prototype intended to hold an
            investor narrative with more confidence.
          </p>
          <div class="vision-actions vision-actions-center">
            <a class="vision-button vision-button-primary" href="#top">Back to prelude</a>
            <a class="vision-button vision-button-secondary" href="#story">Review the sequence</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '~/scripts/vision-homepage';
</script>

<style is:global>
  .vision-page {
    background: linear-gradient(180deg, #f5f4ef 0%, #eef4f2 18%, #f9f7f1 42%, #f5f0e8 60%, #071523 100%);
    color: rgb(14 23 36);
  }

  .vision-container,
  .vision-shell {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .vision-hero {
    position: relative;
    overflow: clip;
    padding: 8.5rem 0 5rem;
  }

  .vision-grain,
  .vision-halo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vision-grain {
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.24)),
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.45) 0, transparent 26%),
      radial-gradient(circle at 80% 10%, rgba(255, 255, 255, 0.18) 0, transparent 18%);
    mix-blend-mode: soft-light;
  }

  .vision-halo-a {
    background: radial-gradient(circle at 18% 24%, rgba(105, 194, 190, 0.32), transparent 30%);
  }

  .vision-halo-b {
    background: radial-gradient(circle at 82% 18%, rgba(223, 160, 113, 0.34), transparent 24%);
  }

  .vision-shell {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
  }

  .vision-copy {
    position: relative;
    z-index: 2;
  }

  .vision-kicker,
  .vision-section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.25rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(11, 86, 95, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    color: rgb(20 99 110);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    backdrop-filter: blur(18px);
  }

  .vision-copy h1,
  .vision-section-head h2,
  .vision-status-copy h2,
  .vision-finale-panel h2 {
    font-family: var(--aw-font-heading);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: rgb(12 24 39);
    text-wrap: balance;
  }

  .vision-copy h1 {
    margin: 0;
    font-size: clamp(3.4rem, 7vw, 6.55rem);
  }

  .vision-copy h1 span {
    display: block;
    color: rgb(20 99 110);
  }

  .vision-lede,
  .vision-section-head p,
  .vision-status-copy p,
  .vision-finale-panel p {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
    line-height: 1.7;
    color: rgba(33, 47, 61, 0.82);
  }

  .vision-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .vision-actions-center {
    justify-content: center;
  }

  .vision-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.35rem;
    padding: 0.9rem 1.35rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .vision-button:hover {
    transform: translateY(-1px);
  }

  .vision-button-primary {
    background: linear-gradient(135deg, rgb(16 91 102), rgb(12 129 140));
    color: white;
    box-shadow: 0 16px 40px -18px rgba(10, 90, 100, 0.5);
  }

  .vision-button-secondary {
    border-color: rgba(13, 67, 78, 0.14);
    background: rgba(255, 255, 255, 0.72);
    color: rgb(14 23 36);
    backdrop-filter: blur(18px);
  }

  .vision-statbar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 2.2rem;
  }

  .vision-statcard,
  .vision-floatcard,
  .vision-chapter-panel,
  .vision-tile,
  .vision-status-panel,
  .vision-finale-panel,
  .vision-rail-card {
    border: 1px solid rgba(12, 70, 78, 0.1);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px);
    box-shadow: 0 22px 65px -40px rgba(14, 42, 51, 0.45);
  }

  .vision-statcard {
    padding: 1rem 1.1rem;
    border-radius: 1.4rem;
  }

  .vision-statlabel,
  .vision-mini-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(34, 54, 70, 0.62);
  }

  .vision-statcard strong {
    display: block;
    margin-top: 0.45rem;
    font-size: 1rem;
    letter-spacing: -0.03em;
    color: rgb(14 23 36);
  }

  .vision-stage-wrap {
    position: relative;
  }

  .vision-stage {
    position: relative;
    min-height: 38rem;
    padding: 1rem;
    border-radius: 2.25rem;
    overflow: hidden;
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.8), rgba(212, 233, 230, 0.45) 45%, rgba(224, 202, 186, 0.42)),
      linear-gradient(180deg, rgba(8, 24, 40, 0.04), rgba(8, 24, 40, 0.12));
    border: 1px solid rgba(11, 65, 73, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 38px 80px -42px rgba(10, 32, 41, 0.45);
  }

  .vision-stage-grid,
  .vision-stage-beam,
  .vision-stage-ring {
    position: absolute;
    inset: 0;
  }

  .vision-stage-grid {
    background-image:
      linear-gradient(rgba(13, 71, 79, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13, 71, 79, 0.075) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.86), transparent);
  }

  .vision-stage-beam {
    background: radial-gradient(circle at 56% 50%, rgba(255, 255, 255, 0.86), transparent 28%);
    filter: blur(3px);
  }

  .vision-stage-ring {
    border-radius: 999px;
    border: 1px solid rgba(31, 102, 112, 0.18);
  }

  .vision-stage-ring-a {
    inset: 12% auto auto 8%;
    width: 16rem;
    height: 16rem;
  }

  .vision-stage-ring-b {
    inset: auto 7% 10% auto;
    width: 11rem;
    height: 11rem;
  }

  .vision-dashboard {
    position: absolute;
    inset: 5.3rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.3rem;
    border-radius: 1.9rem;
    background: linear-gradient(180deg, rgba(7, 23, 38, 0.92), rgba(16, 38, 58, 0.88));
    color: rgba(241, 248, 250, 0.92);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 300ms ease;
  }

  .vision-dashboard-top,
  .vision-dashboard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(216, 233, 236, 0.62);
  }

  .vision-dashboard-main {
    display: grid;
    grid-template-columns: 1fr 0.86fr;
    gap: 1rem;
    flex: 1;
  }

  .vision-dashboard-column {
    display: grid;
    gap: 1rem;
  }

  .vision-mini-panel {
    padding: 1rem;
    border-radius: 1.35rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .vision-mini-panel-dark {
    background: linear-gradient(180deg, rgba(30, 169, 173, 0.15), rgba(14, 59, 72, 0.22));
  }

  .vision-wave,
  .vision-bars {
    display: flex;
    align-items: end;
    gap: 0.45rem;
    margin-top: 1rem;
    min-height: 6rem;
  }

  .vision-wave span,
  .vision-bars span {
    flex: 1 1 0;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(121, 238, 232, 0.96), rgba(40, 160, 171, 0.24));
  }

  .vision-wave span:nth-child(1) {
    height: 36%;
  }
  .vision-wave span:nth-child(2) {
    height: 64%;
  }
  .vision-wave span:nth-child(3) {
    height: 100%;
  }
  .vision-wave span:nth-child(4) {
    height: 58%;
  }
  .vision-wave span:nth-child(5) {
    height: 44%;
  }

  .vision-bars span:nth-child(1) {
    height: 26%;
  }
  .vision-bars span:nth-child(2) {
    height: 88%;
  }
  .vision-bars span:nth-child(3) {
    height: 54%;
  }
  .vision-bars span:nth-child(4) {
    height: 68%;
  }

  .vision-dashboard-center {
    place-items: center;
  }

  .vision-orbit {
    position: relative;
    width: min(17rem, 100%);
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid rgba(132, 231, 223, 0.2);
    background:
      radial-gradient(circle at 50% 50%, rgba(120, 229, 219, 0.14), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  }

  .vision-orbit::before,
  .vision-orbit::after {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: inherit;
    border: 1px dashed rgba(255, 255, 255, 0.14);
  }

  .vision-orbit::after {
    inset: 30%;
    border-style: solid;
    border-color: rgba(228, 166, 118, 0.28);
  }

  .vision-orbit-core {
    position: absolute;
    inset: 50%;
    width: 3.7rem;
    height: 3.7rem;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: radial-gradient(circle at 35% 35%, white, rgba(117, 240, 231, 0.8));
    box-shadow: 0 0 0 1.2rem rgba(94, 206, 197, 0.08);
  }

  .vision-orbit-node {
    position: absolute;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background: rgb(237 188 149);
    box-shadow: 0 0 0 0.45rem rgba(237, 188, 149, 0.15);
  }

  .vision-node-a {
    top: 20%;
    left: 68%;
  }
  .vision-node-b {
    top: 58%;
    left: 14%;
  }
  .vision-node-c {
    top: 75%;
    left: 60%;
  }

  .vision-floatcard {
    position: absolute;
    width: min(15rem, 42%);
    padding: 1rem 1.05rem 1.1rem;
    border-radius: 1.35rem;
    transition: transform 300ms ease;
  }

  .vision-floatcard strong {
    display: block;
    margin-top: 0.5rem;
    font-size: 1rem;
    color: rgb(16 28 43);
  }

  .vision-floatcard p {
    margin: 0.5rem 0 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(33, 47, 61, 0.72);
  }

  .vision-floatcard-a {
    top: 1.4rem;
    left: 1.3rem;
  }

  .vision-floatcard-b {
    right: 1.4rem;
    bottom: 1.5rem;
  }

  .vision-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    background: rgba(17, 119, 129, 0.12);
    color: rgb(15 95 105);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .vision-pill-alt {
    background: rgba(193, 119, 73, 0.12);
    color: rgb(156 82 44);
  }

  .vision-scrollcue {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.3rem;
    color: rgba(25, 56, 67, 0.72);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .vision-scrollcue span {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(18, 88, 98, 0.28);
    position: relative;
  }

  .vision-scrollcue span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.22rem;
    width: 0.22rem;
