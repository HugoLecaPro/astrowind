---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Robeaute — Vision 2035',
  ignoreTitleTemplate: true,
};

const navLinks = [
  { label: 'Vision 2035', href: '#top' },
  { label: 'Technology', href: '#technology' },
  { label: 'Solutions', href: '#solutions' },
  { label: 'Impact', href: '#impact' },
  { label: 'Dashboard', href: '/dashboard' },
  { label: 'About us', href: '#about' },
  { label: 'Careers', href: '#careers' },
];

const brainNodes = [
  { x: 26, y: 34, size: 10 },
  { x: 34, y: 21, size: 9 },
  { x: 43, y: 43, size: 11 },
  { x: 57, y: 33, size: 12 },
  { x: 67, y: 24, size: 9 },
  { x: 74, y: 40, size: 13 },
  { x: 28, y: 56, size: 8 },
  { x: 44, y: 61, size: 10 },
  { x: 56, y: 54, size: 9 },
  { x: 68, y: 64, size: 10 },
  { x: 51, y: 27, size: 16 },
  { x: 61, y: 46, size: 8 },
  { x: 38, y: 49, size: 7 },
  { x: 75, y: 53, size: 8 },
];

const benefits = [
  {
    title: 'Intelligent Physical Agents',
    copy: 'Microbots that sense, understand and act inside the body.',
  },
  {
    title: 'Living Biological Intelligence',
    copy: 'Imaging, multiomics and real-time signals become one adaptive picture.',
  },
  {
    title: 'Personalized Adaptive Care',
    copy: 'Predictive models help align treatment to the right patient state.',
  },
  {
    title: 'From Brain To Whole Body',
    copy: 'The platform expands from CNS monitoring into continuous human intelligence.',
  },
  {
    title: 'A New Era Of Medicine',
    copy: 'Predictive, proactive and precise care framed as an integrated system.',
  },
];

const timeline = [
  { label: 'MRI scan #14', time: '07:53 AM' },
  { label: 'Proteomic instability detected', time: '08:15 AM' },
  { label: 'Localized adaptive nanotherapy deployed', time: '09:42 AM' },
  { label: 'Tumor response improvement +18%', time: '11:02 AM', active: true },
  { label: 'Neuroinflammation stabilized', time: '11:47 AM' },
  { label: 'Predictive relapse probability reduced', time: '12:21 PM' },
];

const omics = ['Genomics', 'Transcriptomics', 'Proteomics', 'Metabolomics', 'Immunomics', 'Phosphoproteomics'];

const nanoPillars = [
  { icon: 'tabler:shield-checkered', title: 'Biocompatible & safe' },
  { icon: 'tabler:current-location', title: 'Autonomous navigation' },
  { icon: 'tabler:activity-heartbeat', title: 'Real-time sensing' },
  { icon: 'tabler:target-arrow', title: 'Targeted therapeutics' },
];

const roadmap = [
  {
    phase: 'Phase 1',
    title: 'Structural shell',
    copy: 'Ship the light-blue glass hero, ribbon cards, nano-robot block, and clean anchor navigation.',
  },
  {
    phase: 'Phase 2',
    title: 'Visual systems',
    copy: 'Replace abstract placeholders with branded product visuals, medical diagrams, and higher-fidelity illustrations.',
  },
  {
    phase: 'Phase 3',
    title: 'Interaction polish',
    copy: 'Tune scroll states, motion choreography, HUD transitions, and mobile behavior without bloating the stack.',
  },
  {
    phase: 'Phase 4',
    title: 'Content pass',
    copy: 'Load the real investor narrative, proof points, and platform explanations into the finished shell.',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="robeaute-header">
      <a class="robeaute-brand" href="#top">
        <span class="robeaute-brand-mark">Robeaute</span>
        <span class="robeaute-brand-tag">Intelligent agents for life</span>
      </a>

      <nav class="robeaute-nav" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a href={link.href} {...(link.href.startsWith('#') ? { 'data-nav-link': link.href.slice(1) } : {})}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <a class="robeaute-contact" href="#careers">
        Contact us
        <span><Icon name="tabler:arrow-up-right" class="h-4 w-4" /></span>
      </a>
    </header>
  </Fragment>

  <div class="robeaute-page">
    <section id="top" class="robeaute-hero" data-section-id="top">
      <div class="robeaute-hero-bg"></div>
      <div class="robeaute-hero-shell">
        <div class="robeaute-copy">
          <h1>
            The future
            <br />
            of medicine
            <br />
            is <span>alive</span>
          </h1>
          <p>Robeaute intelligent physical agents continuously understand, protect and restore human health.</p>

          <a class="robeaute-primary-cta" href="#technology">
            Discover the vision
            <span><Icon name="tabler:arrow-up-right" class="h-4 w-4" /></span>
          </a>
        </div>

        <div class="robeaute-stage-wrap">
          <div class="robeaute-stage" data-hero-stage>
            <div class="robeaute-stage-arc" data-parallax="-8"></div>
            <div class="robeaute-stage-floor"></div>
            <div class="robeaute-stage-floor robeaute-stage-floor-inner"></div>

            <article class="robeaute-panel robeaute-patient-panel" data-parallax="10">
              <h3>Claire Moreau</h3>
              <p>52 years old</p>
              <p>Continuous CNS monitoring</p>
              <p>Adaptive treatment active</p>
            </article>

            <article class="robeaute-panel robeaute-scan-panel" data-parallax="12">
              <h4>MRI Scan #14</h4>
              <div class="robeaute-scan-grid">
                {Array.from({ length: 8 }).map(() => <span class="robeaute-scan-tile" />)}
              </div>
            </article>

            <article class="robeaute-panel robeaute-biomarker-panel" data-parallax="6">
              <h4>Biomarker evolution</h4>
              <div class="robeaute-chart robeaute-chart-biomarker"></div>
              <ul>
                <li>NFL</li>
                <li>GFAP</li>
                <li>IL-6</li>
                <li>Tau</li>
              </ul>
            </article>

            <div class="robeaute-brain" data-parallax="16">
              <div class="robeaute-brain-glow"></div>
              {
                brainNodes.map((node) => (
                  <span
                    class="robeaute-brain-node"
                    style={`left:${node.x}%;top:${node.y}%;--node-size:${node.size}px;`}
                  />
                ))
              }
            </div>

            <div class="robeaute-clinician" data-parallax="18" aria-hidden="true">
              <div class="robeaute-clinician-halo"></div>
              <div class="robeaute-clinician-head"></div>
              <div class="robeaute-clinician-bun"></div>
              <div class="robeaute-clinician-body"></div>
              <div class="robeaute-clinician-arm"></div>
              <div class="robeaute-clinician-hand"></div>
            </div>

            <article class="robeaute-panel robeaute-timeline-panel" data-parallax="8">
              <h4>Treatment timeline</h4>
              <ul>
                {
                  timeline.map((item) => (
                    <li class:list={{ active: item.active }}>
                      <span class="robeaute-timeline-dot" />
                      <div>
                        <strong>{item.label}</strong>
                        <small>{item.time}</small>
                      </div>
                    </li>
                  ))
                }
              </ul>
            </article>

            <article class="robeaute-panel robeaute-twin-panel" data-parallax="9">
              <h4>Digital twin</h4>
              <div class="robeaute-human">
                <span class="robeaute-human-head"></span>
                <span class="robeaute-human-spine"></span>
                <span class="robeaute-human-arm robeaute-human-arm-left"></span>
                <span class="robeaute-human-arm robeaute-human-arm-right"></span>
                <span class="robeaute-human-leg robeaute-human-leg-left"></span>
                <span class="robeaute-human-leg robeaute-human-leg-right"></span>
                <span class="robeaute-human-node node-a"></span>
                <span class="robeaute-human-node node-b"></span>
                <span class="robeaute-human-node node-c"></span>
                <span class="robeaute-human-node node-d"></span>
              </div>
            </article>

            <article class="robeaute-panel robeaute-omics-panel" data-parallax="5">
              <h4>Multiomics</h4>
              <ul>
                {
                  omics.map((item) => (
                    <li>
                      <span>{item}</span>
                      <span class="robeaute-sparkline" />
                    </li>
                  ))
                }
              </ul>
            </article>

            <article class="robeaute-panel robeaute-prediction-panel" data-parallax="7">
              <h4>Adaptive prediction AI</h4>
              <p>Response probability ↑ 87%</p>
              <div class="robeaute-chart robeaute-chart-prediction"></div>
            </article>

            <div class="robeaute-status-pill">
              <span class="robeaute-status-line"></span>
              Adaptive localized treatment active
              <span class="robeaute-status-line"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="solutions" class="robeaute-benefits" data-section-id="solutions">
      <div class="robeaute-benefits-shell">
        {
          benefits.map((item) => (
            <article class="robeaute-benefit-card">
              <div class="robeaute-benefit-icon">
                <Icon name="tabler:atom-2" class="h-5 w-5" />
              </div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <a href="#technology">
                Learn more
                <Icon name="tabler:arrow-right" class="h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section id="technology" class="robeaute-technology" data-section-id="technology">
      <div class="robeaute-technology-shell">
        <div class="robeaute-nano-visual" data-parallax="10">
          <div class="robeaute-capsule-core"></div>
          <span class="robeaute-capsule-fin fin-a"></span>
          <span class="robeaute-capsule-fin fin-b"></span>
          <span class="robeaute-capsule-fin fin-c"></span>
          <span class="robeaute-capsule-fin fin-d"></span>
          <span class="robeaute-bubble bubble-a"></span>
          <span class="robeaute-bubble bubble-b"></span>
          <span class="robeaute-bubble bubble-c"></span>
        </div>

        <div class="robeaute-technology-copy">
          <p class="robeaute-overline">Our technology</p>
          <h2>The Robeauté nano-robot</h2>
          <p>
            Our intelligent physical agents navigate naturally inside the body, sense the right signals, and deliver
            localized therapy with unmatched precision.
          </p>
        </div>

        <div class="robeaute-pillars">
          {
            nanoPillars.map((pillar) => (
              <div class="robeaute-pillar">
                <Icon name={pillar.icon} class="h-7 w-7" />
                <span>{pillar.title}</span>
              </div>
            ))
          }
        </div>

        <a class="robeaute-secondary-cta" href="#impact">
          Discover our nano-robot
          <span><Icon name="tabler:arrow-up-right" class="h-4 w-4" /></span>
        </a>
      </div>
    </section>

    <section id="impact" class="robeaute-roadmap" data-section-id="impact">
      <div class="robeaute-section-head">
        <p class="robeaute-overline">Frontend roadmap</p>
        <h2>What this reference breaks down into on the frontend.</h2>
      </div>

      <div class="robeaute-roadmap-grid">
        {
          roadmap.map((item) => (
            <article class="robeaute-roadmap-card">
              <p class="robeaute-roadmap-phase">{item.phase}</p>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="robeaute-bottom-grid">
      <article id="about" class="robeaute-bottom-card" data-section-id="about">
        <p class="robeaute-overline">About us</p>
        <h2>From brain monitoring to whole-body adaptive medicine.</h2>
        <p>
          This pass focuses on visual structure: trust-building glass surfaces, a medical HUD stage, and a calm
          high-technology atmosphere that can later absorb the real investor narrative.
        </p>
      </article>

      <article id="careers" class="robeaute-bottom-card robeaute-bottom-card-cta" data-section-id="careers">
        <p class="robeaute-overline">Careers</p>
        <h2>Help build intelligent agents for life.</h2>
        <p>The next step is to replace placeholders with real product visuals, team proof, and platform messaging.</p>
        <a class="robeaute-primary-cta" href="mailto:hugo@robeaute.com">
          Start a conversation
          <span><Icon name="tabler:arrow-up-right" class="h-4 w-4" /></span>
        </a>
      </article>
    </section>
  </div>

  <Fragment slot="footer">
    <footer class="robeaute-footer">
      <div>
        <strong>Robeaute</strong>
        <span>Vision shell built from the provided layout reference.</span>
      </div>
      <a href="#top">Back to top</a>
    </footer>
  </Fragment>
</Layout>

<script>
  import '~/scripts/vision-homepage';
</script>

<style is:global>
  .robeaute-page {
    background:
      radial-gradient(circle at 20% 12%, rgba(255, 255, 255, 0.85), transparent 25%),
      radial-gradient(circle at 85% 8%, rgba(255, 255, 255, 0.38), transparent 22%),
      linear-gradient(180deg, #d9e6ff 0%, #d4e1fb 36%, #dce8ff 100%);
    color: #18306d;
  }

  .robeaute-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 70;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    width: min(1420px, calc(100% - 2rem));
    margin: 1.1rem auto 0;
    padding: 0.7rem 0.9rem 0.7rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(224, 235, 255, 0.38);
    backdrop-filter: blur(16px);
    box-shadow: 0 22px 44px -34px rgba(49, 80, 151, 0.6);
  }

  .robeaute-brand {
    display: grid;
    line-height: 1;
  }

  .robeaute-brand-mark {
    font-size: 2.3rem;
    letter-spacing: -0.055em;
    color: #17307a;
  }

  .robeaute-brand-tag {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: rgba(23, 48, 122, 0.74);
  }

  .robeaute-nav {
    display: flex;
    justify-content: center;
    gap: 2rem;
    font-size: 1rem;
    color: rgba(22, 44, 105, 0.82);
  }

  .robeaute-nav a {
    position: relative;
    padding: 0.4rem 0;
    transition: color 180ms ease;
  }

  .robeaute-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 2px;
    border-radius: 999px;
    background: #efe81c;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .robeaute-nav a[data-active='true'],
  .robeaute-nav a:hover {
    color: #172c70;
  }

  .robeaute-nav a[data-active='true']::after,
  .robeaute-nav a:hover::after {
    transform: scaleX(1);
  }

  .robeaute-contact,
  .robeaute-primary-cta,
  .robeaute-secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .robeaute-contact {
    padding: 0.9rem 1.25rem 0.9rem 1.55rem;
    background: #efe81c;
    color: #1b3274;
    box-shadow: 0 16px 28px -20px rgba(208, 201, 0, 0.9);
  }

  .robeaute-contact span,
  .robeaute-primary-cta span,
  .robeaute-secondary-cta span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
  }

  .robeaute-contact:hover,
  .robeaute-primary-cta:hover,
  .robeaute-secondary-cta:hover {
    transform: translateY(-1px);
  }

  .robeaute-hero {
    position: relative;
    padding: 8.8rem 0 2rem;
    overflow: clip;
  }

  .robeaute-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 14% 28%, rgba(255, 255, 255, 0.7), transparent 26%),
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.48), transparent 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), transparent 45%);
    pointer-events: none;
  }

  .robeaute-hero-shell,
  .robeaute-benefits-shell,
  .robeaute-technology-shell,
  .robeaute-roadmap,
  .robeaute-bottom-grid,
  .robeaute-footer {
    width: min(1420px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .robeaute-hero-shell {
    display: grid;
    grid-template-columns: minmax(19rem, 0.95fr) minmax(0, 2.15fr);
    gap: 2rem;
    align-items: center;
  }

  .robeaute-copy {
    padding: 5rem 0 7rem;
  }

  .robeaute-copy h1 {
    margin: 0;
    font-size: clamp(4rem, 6vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
    color: #183175;
  }

  .robeaute-copy h1 span {
    color: #efe81c;
  }

  .robeaute-copy p {
    max-width: 20rem;
    margin: 1.8rem 0 0;
    font-size: 1.18rem;
    line-height: 1.6;
    color: rgba(24, 49, 117, 0.8);
  }

  .robeaute-primary-cta,
  .robeaute-secondary-cta {
    width: fit-content;
    margin-top: 2.5rem;
    padding: 1rem 1.2rem 1rem 1.55rem;
    background: #efe81c;
    color: #183175;
    box-shadow: 0 18px 34px -24px rgba(204, 197, 0, 0.95);
  }

  .robeaute-stage-wrap {
    position: relative;
  }

  .robeaute-stage {
    position: relative;
    min-height: 50rem;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 2rem;
    background: linear-gradient(180deg, rgba(156, 186, 244, 0.42), rgba(168, 198, 255, 0.18)), rgba(183, 206, 255, 0.2);
    backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 36px 90px -54px rgba(57, 88, 165, 0.55);
    overflow: hidden;
  }

  .robeaute-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 46% 31%, rgba(255, 255, 255, 0.34), transparent 24%),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size:
      auto,
      3rem 3rem,
      3rem 3rem;
    pointer-events: none;
  }

  .robeaute-stage-arc {
    position: absolute;
    inset: 1rem -10% auto;
    height: 6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.68);
    border-radius: 999px;
    filter: blur(0.2px);
  }

  .robeaute-stage-floor {
    position: absolute;
    inset: auto 8% 1.9rem;
    height: 7.5rem;
    border-radius: 999px;
    border: 10px solid rgba(255, 255, 255, 0.56);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.6) inset;
  }

  .robeaute-stage-floor-inner {
    inset: auto 16% 4.5rem;
    height: 4.4rem;
    border-width: 4px;
    opacity: 0.8;
  }

  .robeaute-panel,
  .robeaute-benefits-shell,
  .robeaute-technology-shell,
  .robeaute-roadmap-card,
  .robeaute-bottom-card,
  .robeaute-footer {
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(207, 223, 255, 0.33);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px -44px rgba(62, 92, 166, 0.55);
  }

  .robeaute-panel {
    position: absolute;
    padding: 1rem 1.1rem;
    border-radius: 1.3rem;
    color: rgba(238, 245, 255, 0.98);
  }

  .robeaute-panel h3,
  .robeaute-panel h4 {
    margin: 0;
    font-weight: 700;
    color: #f4f8ff;
  }

  .robeaute-panel p,
  .robeaute-panel li,
  .robeaute-panel small,
  .robeaute-panel span {
    color: rgba(239, 246, 255, 0.82);
  }

  .robeaute-patient-panel {
    inset: 1.25rem auto auto 1.25rem;
    width: 17rem;
  }

  .robeaute-patient-panel h3 {
    font-size: 2rem;
    letter-spacing: -0.05em;
  }

  .robeaute-patient-panel p {
    margin: 0.18rem 0 0;
    font-size: 0.98rem;
  }

  .robeaute-scan-panel {
    inset: 9.9rem auto auto 1rem;
    width: 17.5rem;
  }

  .robeaute-scan-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .robeaute-scan-tile {
    aspect-ratio: 1;
    border-radius: 0.7rem;
    background:
      radial-gradient(circle at 50% 50%, rgba(187, 216, 255, 0.95), rgba(118, 150, 223, 0.7)), rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.4);
    position: relative;
  }

  .robeaute-scan-tile::after {
    content: '';
    position: absolute;
    inset: 18%;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .robeaute-biomarker-panel {
    inset: 21rem auto auto 1rem;
    width: 17.5rem;
  }

  .robeaute-chart {
    border-radius: 0.9rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent), rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .robeaute-chart-biomarker {
    height: 5rem;
    margin-top: 0.85rem;
    background-image:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08) 50%, transparent),
      linear-gradient(
        135deg,
        transparent 34%,
        rgba(239, 232, 28, 0.9) 35%,
        rgba(239, 232, 28, 0.9) 37%,
        transparent 38%
      ),
      linear-gradient(
        155deg,
        transparent 44%,
        rgba(156, 219, 255, 0.9) 45%,
        rgba(156, 219, 255, 0.9) 47%,
        transparent 48%
      );
    background-size:
      100% 100%,
      100% 100%,
      100% 100%;
  }

  .robeaute-biomarker-panel ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
  }

  .robeaute-brain {
    position: absolute;
    inset: 3.3rem auto auto 22%;
    width: clamp(18rem, 34vw, 31rem);
