---
import { Icon } from 'astro-icon/components';
import {
  biomarkerSeries,
  caseSummary,
  challengePrompts,
  dashboardDiagnosis,
  initialBiomarkerSeriesId,
  initialPhaseId,
  initialTreatmentId,
  missionCheckpoints,
  missionEventLog,
  missionPhases,
  treatmentOptions,
} from '~/data/clinicianDashboard';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Robeaute Clinician Dashboard',
  ignoreTitleTemplate: true,
};

const navLinks = [
  { label: 'Vision 2035', href: '/' },
  { label: 'Technology', href: '/#technology' },
  { label: 'Solutions', href: '/#solutions' },
  { label: 'Impact', href: '/#impact' },
  { label: 'Dashboard', href: '/dashboard', active: true },
  { label: 'About us', href: '/#about' },
  { label: 'Careers', href: '/#careers' },
];

const initialPhaseIndex = missionPhases.findIndex((phase) => phase.id === initialPhaseId);
const initialPhase = missionPhases[initialPhaseIndex];
const focusedCheckpoint = missionCheckpoints.at(-1)!;
const selectedTreatment = treatmentOptions.find((item) => item.id === initialTreatmentId) ?? treatmentOptions[0];
const initialBiomarkerSeries =
  biomarkerSeries.find((series) => series.id === initialBiomarkerSeriesId) ?? biomarkerSeries[0];
const biomarkerChartWidth = 420;
const biomarkerChartHeight = 212;
const biomarkerChartPaddingX = 18;
const biomarkerChartPaddingY = 24;
const initialBiomarkerValues = initialBiomarkerSeries.points.map((point) => point.value);
const initialBiomarkerMin = Math.min(...initialBiomarkerValues);
const initialBiomarkerMax = Math.max(...initialBiomarkerValues);
const initialBiomarkerRange = Math.max(initialBiomarkerMax - initialBiomarkerMin, 1);
const initialBiomarkerCoordinates = initialBiomarkerSeries.points.map((point, index) => {
  const x =
    biomarkerChartPaddingX +
    (index / Math.max(initialBiomarkerSeries.points.length - 1, 1)) *
      (biomarkerChartWidth - biomarkerChartPaddingX * 2);
  const y =
    biomarkerChartHeight -
    biomarkerChartPaddingY -
    ((point.value - initialBiomarkerMin) / initialBiomarkerRange) * (biomarkerChartHeight - biomarkerChartPaddingY * 2);

  return { ...point, x, y };
});
const initialBiomarkerPath = initialBiomarkerCoordinates
  .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`)
  .join(' ');
const initialBiomarkerCurrentPoint = initialBiomarkerSeries.points.at(-1)!;
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="dashboard-header">
      <a class="dashboard-brand" href="/">
        <span class="dashboard-brand-mark">Robeaute</span>
        <span class="dashboard-brand-tag">Clinician operating layer</span>
      </a>

      <nav class="dashboard-nav" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a href={link.href} data-active={link.active ? 'true' : 'false'}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <a class="dashboard-contact" href="mailto:hugo@robeaute.com">
        Contact us
        <span><Icon name="tabler:arrow-up-right" class="h-4 w-4" /></span>
      </a>
    </header>
  </Fragment>

  <div class="dashboard-page">
    <section class="dashboard-shell">
      <div class="dashboard-titlebar">
        <div>
          <p class="dashboard-kicker">Clinician case workspace</p>
          <h1>Microrobot-guided diagnosis and treatment review</h1>
          <p class="dashboard-subtitle">
            One patient, one lesion, one evidence-to-treatment workflow. The left pane shows the agent’s route inside
            the STL brain. The right pane explains the proposed diagnosis and the treatment choices it unlocks.
          </p>
        </div>

        <div class="dashboard-status">
          <span class="dashboard-status-dot"></span>
          <strong>{caseSummary.patientName}</strong>
          <small>
            {caseSummary.caseTitle} · {caseSummary.status}
          </small>
        </div>
      </div>

      <div class="dashboard-grid">
        <section class="brain-workspace">
          <div class="brain-workspace-top">
            <div>
              <p class="dashboard-overline">3D anatomy workspace</p>
              <h2>Whole-brain context with lesion, route, and active agent state</h2>
              <p class="brain-workspace-copy">
                The STL brain remains the anatomical substrate. The lesion, path checkpoints, and active robot position
                carry the visual emphasis.
              </p>
            </div>

            <div class="brain-badges">
              {caseSummary.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>

          <div class="brain-stage-card">
            <div class="brain-stage-column">
              <div class="brain-canvas-wrap">
                <canvas data-brain-viewer></canvas>

                <div class="brain-stage-legend">
                  <span><i class="legend-chip legend-chip-core"></i>Lesion core</span>
                  <span><i class="legend-chip legend-chip-shell"></i>Peritumoral field</span>
                  <span><i class="legend-chip legend-chip-path"></i>Agent path</span>
                  <span><i class="legend-chip legend-chip-robot"></i>Active agent</span>
                </div>

                <div class="brain-stage-hint">
                  Drag to rotate · Scroll to zoom · Click a checkpoint to inspect its evidence
                </div>
              </div>

              <div class="mission-scrubber-card">
                <div class="mission-scrubber-top">
                  <div>
                    <p class="dashboard-overline">Robot mission replay</p>
                    <h3 data-phase-heading>{initialPhase.title}</h3>
                  </div>
                  <span class="mission-phase-pill" data-phase-pill>
                    {initialPhase.label}
                  </span>
                </div>

                <p class="mission-phase-copy" data-phase-copy>
                  {initialPhase.copy}
                </p>

                <input
                  type="range"
                  min="0"
                  max={missionPhases.length - 1}
                  step="1"
                  value={initialPhaseIndex}
                  data-mission-scrubber
                />

                <div class="mission-phase-track">
                  {
                    missionPhases.map((phase, index) => (
                      <button type="button" class="phase-stop" data-phase-button data-phase-index={index}>
                        <strong>{phase.label}</strong>
                        <span>{phase.time}</span>
                      </button>
                    ))
                  }
                </div>
              </div>
            </div>

            <aside class="brain-gui">
              <section class="brain-gui-block">
                <p>View controls</p>
                <div class="brain-gui-actions">
                  <button type="button" data-brain-action="reset">Whole brain</button>
                  <button type="button" data-brain-action="focus-lesion">Focus lesion</button>
                </div>
              </section>

              <section class="brain-gui-block">
                <label class="brain-toggle">
                  <span>Auto rotate</span>
                  <input type="checkbox" data-brain-toggle="autorotate" checked />
                </label>
                <label class="brain-toggle">
                  <span>Wireframe</span>
                  <input type="checkbox" data-brain-toggle="wireframe" />
                </label>
                <label>
                  <span>Brain shell opacity</span>
                  <input type="range" min="0" max="100" value="58" data-brain-range="opacity" />
                </label>
              </section>

              <section class="brain-gui-readout">
                <div>
                  <span>Model</span>
                  <strong data-brain-readout="triangles">Loading…</strong>
                </div>
                <div>
                  <span>Viewport</span>
                  <strong data-brain-readout="viewport">Ready</strong>
                </div>
                <div>
                  <span>Current phase</span>
                  <strong data-brain-readout="phase">{initialPhase.label}</strong>
                </div>
                <div>
                  <span>Agent location</span>
                  <strong data-brain-readout="agent">{caseSummary.distanceToCore}</strong>
                </div>
              </section>

              <section class="brain-gui-note">
                <p>Checkpoint selection updates the evidence panel without collapsing the rest of the case.</p>
              </section>
            </aside>
          </div>
        </section>

        <aside class="dashboard-panels">
          <article class="mission-alert">
            <div class="mission-alert-head">
              <div>
                <p class="dashboard-overline">Mission notification</p>
                <h2 data-mission-alert-title>Mission complete</h2>
              </div>
              <span class="mission-alert-badge" data-mission-alert-badge>Review ready</span>
            </div>

            <p class="mission-alert-copy" data-mission-alert-copy>
              Diagnostic package ready for review. The deployed robot completed its localized route and halted at the
              lesion margin with stable local conditions.
            </p>

            <p class="mission-log-label">Case progression</p>
            <ul class="mission-event-log">
              {
                missionEventLog.map((item, index) => (
                  <li data-event-log-index={index} data-event-phase={item.phaseIndex}>
                    <span>{item.time}</span>
                    <strong>{item.label}</strong>
                  </li>
                ))
              }
            </ul>
          </article>

          <div class="workflow-stack">
            <article class="workflow-card" data-accordion-item="mission-status">
              <button
                type="button"
                class="workflow-summary"
                data-accordion-trigger="mission-status"
                aria-expanded="false"
              >
                <div>
                  <p class="dashboard-overline">Robot mission status</p>
                  <h3>Implantation to diagnosis package, separated from the broader case journey</h3>
                </div>
                <span class="workflow-badge" data-mission-summary-badge>{caseSummary.status}</span>
              </button>

              <div class="workflow-panel" data-accordion-panel="mission-status" hidden>
                <div class="metric-grid">
                  <div class="metric-card">
                    <span>Mission duration</span>
                    <strong data-mission-duration>{caseSummary.missionDuration}</strong>
                  </div>
                  <div class="metric-card">
                    <span>Path completion</span>
                    <strong data-path-completion>100%</strong>
                  </div>
                  <div class="metric-card">
                    <span>Agent location</span>
                    <strong data-agent-location>{caseSummary.distanceToCore}</strong>
                  </div>
                </div>

                <ul class="phase-list">
                  {
                    missionPhases.map((phase, index) => (
                      <li data-phase-row={index}>
                        <span>{phase.time}</span>
                        <div>
                          <strong>{phase.label}</strong>
                          <p>{phase.copy}</p>
                        </div>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </article>

            <article class="workflow-card" data-accordion-item="evidence">
              <button type="button" class="workflow-summary" data-accordion-trigger="evidence" aria-expanded="true">
                <div>
                  <p class="dashboard-overline">Evidence</p>
                  <h3>Checkpoint-linked biomarker and optical biopsy package</h3>
                </div>
                <span class="workflow-badge">{missionCheckpoints.length} checkpoints</span>
              </button>

              <div class="workflow-panel" data-accordion-panel="evidence">
                <div class="evidence-hero">
                  <div>
                    <span class="evidence-pill">Focused checkpoint</span>
                    <h4 data-evidence-label>{focusedCheckpoint.label}</h4>
                  </div>
                  <strong data-evidence-time>{focusedCheckpoint.time}</strong>
                </div>

                <p class="evidence-copy" data-evidence-note>
                  {focusedCheckpoint.note}
                </p>

                <div class="evidence-chart-card">
                  <div class="evidence-chart-head">
                    <div>
                      <span class="evidence-chart-kicker">Biomarker timeseries</span>
                      <h5 data-biomarker-series-label>{initialBiomarkerSeries.label}</h5>
                    </div>

                    <div class="evidence-chart-current">
                      <span>Current state</span>
                      <strong data-biomarker-current-value>
                        {initialBiomarkerCurrentPoint.value}
                        {initialBiomarkerSeries.unit}
                      </strong>
                    </div>
                  </div>

                  <div class="evidence-series-tabs">
                    {
                      biomarkerSeries.map((series) => (
                        <button
                          type="button"
                          class="evidence-series-tab"
                          data-biomarker-series-button={series.id}
                          data-active={series.id === initialBiomarkerSeries.id ? 'true' : 'false'}
                        >
                          {series.label}
                        </button>
                      ))
                    }
                  </div>

                  <div class="evidence-chart-wrap">
                    <svg
                      viewBox={`0 0 ${biomarkerChartWidth} ${biomarkerChartHeight}`}
                      class="evidence-chart-svg"
                      data-biomarker-chart-svg
                      aria-label="Biomarker timeseries"
                    >
                      {
                        [0.2, 0.5, 0.8].map((ratio) => {
                          const y =
                            biomarkerChartHeight -
                            biomarkerChartPaddingY -
                            ratio * (biomarkerChartHeight - biomarkerChartPaddingY * 2);
                          return (
                            <line
                              x1={biomarkerChartPaddingX}
                              y1={y}
                              x2={biomarkerChartWidth - biomarkerChartPaddingX}
                              y2={y}
                              class="evidence-grid-line"
                            />
                          );
                        })
                      }
                      <path
                        d={initialBiomarkerPath}
                        class="evidence-chart-trace"
                        style={`--trace-color:${initialBiomarkerSeries.color};`}></path>
                      {
                        initialBiomarkerCoordinates.map((point, index) => (
                          <>
                            <circle
                              cx={point.x}
                              cy={point.y}
                              r={index === initialBiomarkerCoordinates.length - 1 ? 6 : 4}
                              class="evidence-chart-point"
                              style={`--point-color:${initialBiomarkerSeries.color};`}
                            />
                            <text x={point.x} y={biomarkerChartHeight - 6} class="evidence-chart-label">
                              {point.label}
                            </text>
                          </>
                        ))
                      }
                    </svg>
                  </div>

                  <div class="evidence-chart-meta">
                    <p data-biomarker-series-summary>{initialBiomarkerSeries.summary}</p>
                    <span data-biomarker-current-trend>
                      Focused at {focusedCheckpoint.label} · {focusedCheckpoint.time}
                    </span>
                  </div>
                </div>

                <div class="signal-grid" data-evidence-signals>
                  {
                    focusedCheckpoint.signals.map((signal) => (
                      <div class="signal-card">
                        <span>{signal.label}</span>
                        <strong>{signal.value}</strong>
                        <small>{signal.trend}</small>
                      </div>
                    ))
                  }
                </div>

                <div class="evidence-notes">
                  <div>
                    <span>Spatial context</span>
                    <p data-evidence-context>{focusedCheckpoint.context}</p>
                  </div>
                  <div>
                    <span>Optical biopsy</span>
                    <p data-evidence-optical>{focusedCheckpoint.opticalBiopsy}</p>
                  </div>
                </div>

                <div class="tag-row" data-evidence-provenance>
                  {focusedCheckpoint.provenance.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </article>

            <article class="workflow-card" data-accordion-item="diagnosis">
              <button type="button" class="workflow-summary" data-accordion-trigger="diagnosis" aria-expanded="false">
                <div>
                  <p class="dashboard-overline">Proposed diagnosis</p>
                  <h3>{dashboardDiagnosis.label}</h3>
                </div>
                <span class="workflow-badge" data-diagnosis-confidence>{dashboardDiagnosis.confidence}</span>
              </button>

              <div class="workflow-panel" data-accordion-panel="diagnosis" hidden>
                <div class="diagnosis-card">
                  <div class="diagnosis-head">
                    <div>
                      <span>Confidence</span>
                      <strong>{dashboardDiagnosis.confidence}</strong>
                    </div>
                    <div>
                      <span>Status</span>
                      <strong data-diagnosis-state>Reviewable</strong>
                    </div>
                  </div>

                  <ul class="diagnosis-rationale">
                    {dashboardDiagnosis.rationale.map((item) => <li>{item}</li>)}
                  </ul>

                  <div class="tag-row">
                    {dashboardDiagnosis.provenance.map((tag) => <span>{tag}</span>)}
                  </div>
                </div>
              </div>
            </article>

            <article class="workflow-card" data-accordion-item="challenge">
              <button type="button" class="workflow-summary" data-accordion-trigger="challenge" aria-expanded="false">
                <div>
                  <p class="dashboard-overline">Challenge</p>
                  <h3>Clinician review prompts remain lightweight and explicit</h3>
                </div>
                <span class="workflow-badge" data-review-state>Needs acknowledgment</span>
              </button>

              <div class="workflow-panel" data-accordion-panel="challenge" hidden>
                <div class="prompt-grid">
                  {
                    challengePrompts.map((prompt) => (
                      <button type="button" class="prompt-chip" data-review-prompt>
                        {prompt}
                      </button>
                    ))
                  }
                </div>

                <div class="challenge-note">
                  <span>Alternate interpretation</span>
                  <p>
                    Reserve this area for a clinician override or a lightweight “needs more evidence” decision without
                    turning the MVP into a full annotation suite.
                  </p>
                </div>
              </div>
            </article>

            <article class="workflow-card" data-accordion-item="treatment">
              <button type="button" class="workflow-summary" data-accordion-trigger="treatment" aria-expanded="false">
                <div>
                  <p class="dashboard-overline">Treatment comparison</p>
                  <h3>Three action-ready therapies derived from the recorded evidence</h3>
                </div>
                <span class="workflow-badge" data-treatment-summary>{selectedTreatment.label}</span>
              </button>

              <div class="workflow-panel" data-accordion-panel="treatment" hidden>
                <div class="treatment-grid">
                  {
                    treatmentOptions.map((option) => (
                      <button
                        type="button"
                        class="treatment-card"
                        data-treatment-button={option.id}
                        data-active={option.id === selectedTreatment.id ? 'true' : 'false'}
                      >
                        <strong>{option.label}</strong>
                        <p>{option.summary}</p>
                      </button>
                    ))
                  }
                </div>

                <div class="treatment-detail-card">
                  <div class="treatment-detail-head">
                    <div>
                      <span data-treatment-label>{selectedTreatment.label}</span>
                      <h4 data-treatment-fit>{selectedTreatment.fit}</h4>
                    </div>
                    <span class="workflow-badge" data-treatment-risk>{selectedTreatment.riskBand}</span>
                  </div>

                  <p class="evidence-copy" data-treatment-copy>
                    {selectedTreatment.summary}
                  </p>

                  <div class="metric-grid">
                    <div class="metric-card">
                      <span>Progression risk</span>
                      <strong data-treatment-progression>{selectedTreatment.progressionRisk}</strong>
                    </div>
                    <div class="metric-card">
                      <span>Reintervention</span>
                      <strong data-treatment-reintervention>
                        {selectedTreatment.reinterventionLikelihood}
                      </strong>
                    </div>
                    <div class="metric-card">
                      <span>Monitoring burden</span>
                      <strong data-treatment-monitoring>{selectedTreatment.monitoringBurden}</strong>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </div>
        </aside>
      </div>
    </section>
  </div>

  <Fragment slot="footer">
    <footer class="dashboard-footer">
      <div>
        <strong>Clinician dashboard MVP</strong>
        <span>Single-case mission review with synchronized STL scene and decision workflow</span>
      </div>
      <a href="/">Back to vision page</a>
    </footer>
  </Fragment>
</Layout>

<script>
  import '~/scripts/clinician-dashboard';
</script>

<style is:global>
  .dashboard-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 16% 8%, rgba(255, 255, 255, 0.85), transparent 22%),
      radial-gradient(circle at 86% 10%, rgba(255, 255, 255, 0.3), transparent 28%),
      linear-gradient(180deg, #d6e4ff 0%, #dfeaff 42%, #eaf1ff 100%);
    color: #18306d;
  }

  .dashboard-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    width: min(1440px, calc(100% - 2rem));
    margin: 1rem auto 0;
    padding: 0.75rem 0.95rem 0.75rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.46);
    border-radius: 999px;
    background: rgba(224, 235, 255, 0.44);
    backdrop-filter: blur(18px);
    box-shadow: 0 22px 44px -34px rgba(49, 80, 151, 0.6);
  }

  .dashboard-brand {
    display: grid;
    line-height: 1;
  }

  .dashboard-brand-mark {
    font-size: 2rem;
    letter-spacing: -0.055em;
    color: #17307a;
  }

  .dashboard-brand-tag {
    margin-top: 0.18rem;
    font-size: 0.8rem;
    color: rgba(23, 48, 122, 0.74);
  }

  .dashboard-nav {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
    font-size: 0.98rem;
    color: rgba(22, 44, 105, 0.82);
  }

  .dashboard-nav a {
    position: relative;
    padding: 0.35rem 0;
    transition: color 180ms ease;
  }

  .dashboard-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 2px;
    border-radius: 999px;
    background: #efe81c;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .dashboard-nav a[data-active='true'],
  .dashboard-nav a:hover {
    color: #172c70;
  }

  .dashboard-nav a[data-active='true']::after,
  .dashboard-nav a:hover::after {
    transform: scaleX(1);
  }

  .dashboard-contact,
  .brain-gui-actions button,
  .phase-stop,
  .prompt-chip,
  .treatment-card {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .dashboard-contact {
    padding: 0.9rem 1.2rem 0.9rem 1.5rem;
    background: #efe81c;
    color: #1b3274;
    box-shadow: 0 16px 28px -20px rgba(208, 201, 0, 0.9);
  }

  .dashboard-contact span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
  }

  .dashboard-shell,
  .dashboard-footer {
    width: min(1440px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .dashboard-shell {
    padding: 8.6rem 0 3rem;
  }

  .dashboard-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .dashboard-kicker,
  .dashboard-overline {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d7ca11;
  }

  .dashboard-titlebar h1,
  .brain-workspace-top h2,
  .mission-alert h2,
  .workflow-summary h3,
  .mission-scrubber-top h3 {
    margin: 0.55rem 0 0;
    letter-spacing: -0.05em;
    color: #18306d;
  }

  .dashboard-titlebar h1 {
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1.02;
  }

  .dashboard-subtitle,
  .brain-workspace-copy,
  .mission-alert-copy,
  .mission-phase-copy,
  .evidence-copy,
  .phase-list p,
  .challenge-note p,
  .treatment-card p {
    line-height: 1.68;
    color: rgba(24, 48, 109, 0.8);
  }

  .dashboard-subtitle {
    max-width: 44rem;
    margin: 1rem 0 0;
    font-size: 1.05rem;
  }

  .dashboard-status {
    display: grid;
    gap: 0.2rem;
    min-width: 19rem;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 1.2rem;
    background: rgba(217, 229, 255, 0.52);
    backdrop-filter: blur(14px);
    color: #18306d;
  }

  .dashboard-status strong {
    font-size: 1.08rem;
  }

  .dashboard-status small {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(24, 48, 109, 0.74);
  }

  .dashboard-status-dot {
    display: inline-flex;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: #efe81c;
    box-shadow: 0 0 0 0.3rem rgba(239, 232, 28, 0.18);
  }

  .dashboard-grid {
