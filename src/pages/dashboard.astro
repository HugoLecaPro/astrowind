---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Robeaute Clinician Dashboard',
  ignoreTitleTemplate: true,
};

const navLinks = [
  { label: 'Vision 2035', href: '/' },
  { label: 'Technology', href: '/#technology' },
  { label: 'Solutions', href: '/#solutions' },
  { label: 'Impact', href: '/#impact' },
  { label: 'Dashboard', href: '/dashboard', active: true },
  { label: 'About us', href: '/#about' },
  { label: 'Careers', href: '/#careers' },
];

const biomarkers = [
  { label: 'Inflammation index', value: '0.24', delta: '-12%' },
  { label: 'CNS activity coherence', value: '87%', delta: '+5%' },
  { label: 'Adaptive response signal', value: 'Stable', delta: 'Live' },
];

const timeline = [
  { time: '07:53', title: 'MRI scan ingested', copy: 'New structural series aligned with prior session.' },
  { time: '08:15', title: 'Proteomic anomaly detected', copy: 'AI flagged drift in inflammatory markers.' },
  { time: '09:42', title: 'Localized nanotherapy prepared', copy: 'Delivery path matched to patient-specific model.' },
  { time: '11:02', title: 'Response threshold crossed', copy: 'Digital twin predicts therapeutic benefit increase.' },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="dashboard-header">
      <a class="dashboard-brand" href="/">
        <span class="dashboard-brand-mark">Robeaute</span>
        <span class="dashboard-brand-tag">Clinician operating layer</span>
      </a>

      <nav class="dashboard-nav" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a href={link.href} data-active={link.active ? 'true' : 'false'}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <a class="dashboard-contact" href="mailto:hugo@robeaute.com">
        Contact us
        <span><Icon name="tabler:arrow-up-right" class="h-4 w-4" /></span>
      </a>
    </header>
  </Fragment>

  <div class="dashboard-page">
    <section class="dashboard-shell">
      <div class="dashboard-titlebar">
        <div>
          <p class="dashboard-kicker">Clinician dashboard</p>
          <h1>Patient-specific adaptive brain monitoring</h1>
          <p class="dashboard-subtitle">
            Interactive STL rendering on the left, live clinical context and treatment intelligence on the right.
          </p>
        </div>

        <div class="dashboard-status">
          <span class="dashboard-status-dot"></span>
          Claire Moreau
          <small>Adaptive treatment active</small>
        </div>
      </div>

      <div class="dashboard-grid">
        <section class="brain-workspace">
          <div class="brain-workspace-top">
            <div>
              <p class="dashboard-overline">3D brain model</p>
              <h2>Interactive neural anatomy viewer</h2>
            </div>

            <div class="brain-badges">
              <span>STL loaded</span>
              <span>Orbit enabled</span>
            </div>
          </div>

          <div class="brain-stage-card">
            <div class="brain-canvas-wrap">
              <canvas data-brain-viewer></canvas>
              <div class="brain-stage-hint">Drag to rotate · Scroll to zoom · Shift + drag to pan</div>
            </div>

            <aside class="brain-gui">
              <div class="brain-gui-block">
                <p>View controls</p>
                <div class="brain-gui-actions">
                  <button type="button" data-brain-action="reset">Reset view</button>
                  <button type="button" data-brain-action="focus">Focus brain</button>
                </div>
              </div>

              <div class="brain-gui-block">
                <label class="brain-toggle">
                  <span>Auto rotate</span>
                  <input type="checkbox" data-brain-toggle="autorotate" checked />
                </label>
                <label class="brain-toggle">
                  <span>Wireframe</span>
                  <input type="checkbox" data-brain-toggle="wireframe" />
                </label>
              </div>

              <div class="brain-gui-block">
                <label>
                  <span>Opacity</span>
                  <input type="range" min="35" max="100" value="88" data-brain-range="opacity" />
                </label>
                <label>
                  <span>Glow intensity</span>
                  <input type="range" min="0" max="120" value="62" data-brain-range="emissive" />
                </label>
                <label>
                  <span>Rotation speed</span>
                  <input type="range" min="0" max="100" value="30" data-brain-range="speed" />
                </label>
              </div>

              <div class="brain-gui-readout">
                <div>
                  <span>Model</span>
                  <strong data-brain-readout="triangles">Loading…</strong>
                </div>
                <div>
                  <span>Viewport</span>
                  <strong data-brain-readout="viewport">Ready</strong>
                </div>
              </div>
            </aside>
          </div>
        </section>

        <aside class="dashboard-panels">
          <article class="dashboard-card patient-card">
            <div class="patient-card-top">
              <div>
                <p class="dashboard-overline">Patient context</p>
                <h2>Claire Moreau</h2>
              </div>
              <span class="patient-age">52 years old</span>
            </div>

            <div class="patient-tags">
              <span>Continuous CNS monitoring</span>
              <span>Localized adaptive therapy</span>
              <span>Digital twin active</span>
            </div>
          </article>

          <article class="dashboard-card biomarker-card">
            <div class="card-head">
              <div>
                <p class="dashboard-overline">Biomarkers</p>
                <h3>Live adaptive indicators</h3>
              </div>
              <Icon name="tabler:activity-heartbeat" class="h-5 w-5" />
            </div>

            <div class="biomarker-list">
              {
                biomarkers.map((item) => (
                  <div class="biomarker-row">
                    <div>
                      <span>{item.label}</span>
                      <strong>{item.value}</strong>
                    </div>
                    <small>{item.delta}</small>
                  </div>
                ))
              }
            </div>
          </article>

          <article class="dashboard-card timeline-card">
            <div class="card-head">
              <div>
                <p class="dashboard-overline">Treatment timeline</p>
                <h3>Session sequence</h3>
              </div>
              <Icon name="tabler:timeline-event" class="h-5 w-5" />
            </div>

            <ul>
              {
                timeline.map((item) => (
                  <li>
                    <span class="timeline-time">{item.time}</span>
                    <div>
                      <strong>{item.title}</strong>
                      <p>{item.copy}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </article>

          <article class="dashboard-card twin-card">
            <div class="card-head">
              <div>
                <p class="dashboard-overline">Prediction layer</p>
                <h3>Digital twin confidence</h3>
              </div>
              <span class="twin-score">87%</span>
            </div>

            <div class="twin-curve"></div>
            <p class="twin-note">
              Response probability is trending upward as localized adaptive delivery aligns with the patient model.
            </p>
          </article>
        </aside>
      </div>
    </section>
  </div>

  <Fragment slot="footer">
    <footer class="dashboard-footer">
      <div>
        <strong>Clinician dashboard</strong>
        <span>3D STL viewer + clinical HUD prototype</span>
      </div>
      <a href="/">Back to vision page</a>
    </footer>
  </Fragment>
</Layout>

<script>
  import '~/scripts/clinician-dashboard';
</script>

<style is:global>
  .dashboard-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 18% 10%, rgba(255, 255, 255, 0.76), transparent 25%),
      radial-gradient(circle at 85% 12%, rgba(255, 255, 255, 0.32), transparent 24%),
      linear-gradient(180deg, #d5e4ff 0%, #d9e7ff 38%, #e5efff 100%);
    color: #18306d;
  }

  .dashboard-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    width: min(1440px, calc(100% - 2rem));
    margin: 1rem auto 0;
    padding: 0.75rem 0.95rem 0.75rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.46);
    border-radius: 999px;
    background: rgba(224, 235, 255, 0.44);
    backdrop-filter: blur(18px);
    box-shadow: 0 22px 44px -34px rgba(49, 80, 151, 0.6);
  }

  .dashboard-brand {
    display: grid;
    line-height: 1;
  }

  .dashboard-brand-mark {
    font-size: 2rem;
    letter-spacing: -0.055em;
    color: #17307a;
  }

  .dashboard-brand-tag {
    margin-top: 0.18rem;
    font-size: 0.8rem;
    color: rgba(23, 48, 122, 0.74);
  }

  .dashboard-nav {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
    font-size: 0.98rem;
    color: rgba(22, 44, 105, 0.82);
  }

  .dashboard-nav a {
    position: relative;
    padding: 0.35rem 0;
    transition: color 180ms ease;
  }

  .dashboard-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 2px;
    border-radius: 999px;
    background: #efe81c;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .dashboard-nav a[data-active='true'],
  .dashboard-nav a:hover {
    color: #172c70;
  }

  .dashboard-nav a[data-active='true']::after,
  .dashboard-nav a:hover::after {
    transform: scaleX(1);
  }

  .dashboard-contact,
  .brain-gui-actions button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .dashboard-contact {
    padding: 0.9rem 1.2rem 0.9rem 1.5rem;
    background: #efe81c;
    color: #1b3274;
    box-shadow: 0 16px 28px -20px rgba(208, 201, 0, 0.9);
  }

  .dashboard-contact span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
  }

  .dashboard-shell,
  .dashboard-footer {
    width: min(1440px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .dashboard-shell {
    padding: 8.6rem 0 3rem;
  }

  .dashboard-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .dashboard-kicker,
  .dashboard-overline {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d7ca11;
  }

  .dashboard-titlebar h1,
  .brain-workspace-top h2,
  .patient-card h2,
  .dashboard-card h3 {
    margin: 0.55rem 0 0;
    letter-spacing: -0.05em;
    color: #18306d;
  }

  .dashboard-titlebar h1 {
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1.02;
  }

  .dashboard-subtitle {
    max-width: 42rem;
    margin: 1rem 0 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(24, 48, 109, 0.8);
  }

  .dashboard-status {
    display: grid;
    gap: 0.2rem;
    min-width: 16rem;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 1.2rem;
    background: rgba(217, 229, 255, 0.52);
    backdrop-filter: blur(14px);
    font-weight: 700;
    color: #18306d;
  }

  .dashboard-status small {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(24, 48, 109, 0.74);
  }

  .dashboard-status-dot {
    display: inline-flex;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: #efe81c;
    box-shadow: 0 0 0 0.3rem rgba(239, 232, 28, 0.18);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(22rem, 0.86fr);
    gap: 1rem;
    align-items: start;
  }

  .brain-workspace,
  .dashboard-card,
  .dashboard-footer {
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(207, 223, 255, 0.35);
    backdrop-filter: blur(16px);
    box-shadow: 0 24px 60px -44px rgba(62, 92, 166, 0.55);
  }

  .brain-workspace {
    padding: 1.4rem;
    border-radius: 1.8rem;
  }

  .brain-workspace-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
  }

  .brain-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .brain-badges span,
  .patient-tags span {
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.52);
    background: rgba(232, 239, 255, 0.55);
    font-size: 0.82rem;
    font-weight: 700;
    color: #22418b;
  }

  .brain-stage-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 1rem;
    margin-top: 1.35rem;
  }

  .brain-canvas-wrap {
    position: relative;
    min-height: 39rem;
    border-radius: 1.5rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.72), rgba(166, 191, 248, 0.26) 44%, transparent 54%),
      linear-gradient(180deg, rgba(148, 176, 236, 0.28), rgba(235, 242, 255, 0.48));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .brain-canvas-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 2.6rem 2.6rem;
    pointer-events: none;
  }

  .brain-canvas-wrap canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .brain-stage-hint {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    background: rgba(226, 236, 255, 0.62);
    backdrop-filter: blur(10px);
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(24, 48, 109, 0.82);
    text-align: center;
  }

  .brain-gui {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .brain-gui-block,
  .brain-gui-readout {
    padding: 1rem;
    border-radius: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.48);
    background: rgba(227, 236, 255, 0.56);
  }

  .brain-gui-block p {
    margin: 0 0 0.8rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d4c90b;
  }

  .brain-gui-actions {
    display: grid;
    gap: 0.65rem;
  }

  .brain-gui-actions button {
    justify-content: center;
    padding: 0.82rem 1rem;
    background: #efe81c;
    color: #1b3274;
  }

  .brain-toggle,
  .brain-gui-block label {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
    color: #18306d;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .brain-toggle {
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .brain-gui-block label:last-child,
  .brain-toggle:last-child {
    margin-bottom: 0;
  }

  .brain-gui-block input[type='range'] {
    width: 100%;
    accent-color: #d9cf13;
  }

  .brain-gui-readout {
    display: grid;
    gap: 0.8rem;
  }

  .brain-gui-readout span {
    display: block;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(24, 48, 109, 0.66);
  }

  .brain-gui-readout strong {
    display: block;
    margin-top: 0.35rem;
    color: #18306d;
  }

  .dashboard-panels {
    display: grid;
    gap: 1rem;
  }

  .dashboard-card {
    padding: 1.2rem;
    border-radius: 1.6rem;
  }

  .card-head,
  .patient-card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
  }

  .patient-age,
  .twin-score {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    background: rgba(239, 232, 28, 0.72);
    color: #18306d;
    font-weight: 800;
  }

  .patient-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .biomarker-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .biomarker-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    background: rgba(235, 241, 255, 0.52);
  }

  .biomarker-row span {
    display: block;
    font-size: 0.86rem;
    color: rgba(24, 48, 109, 0.7);
  }

  .biomarker-row strong {
    display: block;
    margin-top: 0.22rem;
    color: #18306d;
  }

  .biomarker-row small {
    font-weight: 800;
    color: #22418b;
  }

  .timeline-card ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .timeline-card li {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.8rem;
    padding: 0.95rem 1rem;
    border-radius: 1rem;
    background: rgba(235, 241, 255, 0.52);
  }

  .timeline-time {
    font-weight: 800;
    color: #d4c90b;
  }

  .timeline-card strong {
    display: block;
    color: #18306d;
  }

  .timeline-card p,
  .twin-note {
    margin: 0.4rem 0 0;
    line-height: 1.6;
    color: rgba(24, 48, 109, 0.76);
  }

  .twin-curve {
    height: 8.5rem;
    margin-top: 1rem;
    border-radius: 1.2rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), transparent),
      linear-gradient(
        130deg,
        transparent 18%,
        rgba(239, 232, 28, 0.92) 19%,
        rgba(239, 232, 28, 0.92) 21%,
        transparent 22%
      ),
      linear-gradient(
        115deg,
        transparent 34%,
        rgba(255, 255, 255, 0.8) 35%,
        rgba(255, 255, 255, 0.8) 37%,
        transparent 38%
      ),
      linear-gradient(
        98deg,
        transparent 58%,
        rgba(239, 232, 28, 0.92) 59%,
        rgba(239, 232, 28, 0.92) 61%,
        transparent 62%
      ),
      rgba(235, 241, 255, 0.56);
    border: 1px solid rgba(255, 255, 255, 0.44);
  }

  .dashboard-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem 1.2rem;
    border-radius: 1.4rem;
    color: rgba(24, 48, 109, 0.82);
  }

  .dashboard-footer div {
    display: grid;
    gap: 0.2rem;
  }

  .dashboard-footer strong,
  .dashboard-footer a {
    color: #18306d;
  }

  @media (max-width: 1280px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .brain-stage-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 960px) {
    .dashboard-header {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      border-radius: 1.5rem;
    }

    .dashboard-nav {
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.2rem;
    }

    .dashboard-contact {
      display: none;
    }

    .dashboard-shell {
      padding-top: 11rem;
    }

    .dashboard-titlebar {
      flex-direction: column;
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .dashboard-shell,
    .dashboard-footer {
      width: min(100% - 1rem, 1440px);
    }

    .dashboard-footer {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
