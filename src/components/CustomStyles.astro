---
import '@fontsource-variable/manrope';
import '@fontsource/newsreader';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Manrope Variable';
    --aw-font-serif: 'Manrope Variable';
    --aw-font-heading: 'Manrope Variable';

    --aw-color-primary: rgb(23 44 112);
    --aw-color-secondary: rgb(104 139 221);
    --aw-color-accent: rgb(239 232 28);

    --aw-color-text-heading: rgb(21 42 108);
    --aw-color-text-default: rgb(34 57 123);
    --aw-color-text-muted: rgb(34 57 123 / 72%);
    --aw-color-bg-page: rgb(222 232 255);

    --aw-color-bg-page-dark: rgb(10 20 49);

    ::selection {
      background-color: rgb(239 232 28);
      color: rgb(21 42 108);
    }
  }

  .dark {
    --aw-font-sans: 'Manrope Variable';
    --aw-font-serif: 'Manrope Variable';
    --aw-font-heading: 'Manrope Variable';

    --aw-color-primary: rgb(159 187 255);
    --aw-color-secondary: rgb(116 169 255);
    --aw-color-accent: rgb(239 232 28);

    --aw-color-text-heading: rgb(238 244 255);
    --aw-color-text-default: rgb(220 229 248);
    --aw-color-text-muted: rgb(220 229 248 / 72%);
    --aw-color-bg-page: rgb(10 20 49);

    ::selection {
      background-color: rgb(239 232 28);
      color: rgb(10 20 49);
    }
  }
</style>
