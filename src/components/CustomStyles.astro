---
import '@fontsource-variable/manrope';
import '@fontsource/newsreader';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Manrope Variable';
    --aw-font-serif: 'Newsreader';
    --aw-font-heading: 'Newsreader';

    --aw-color-primary: rgb(20 99 110);
    --aw-color-secondary: rgb(12 129 140);
    --aw-color-accent: rgb(183 104 58);

    --aw-color-text-heading: rgb(14 23 36);
    --aw-color-text-default: rgb(33 47 61);
    --aw-color-text-muted: rgb(33 47 61 / 70%);
    --aw-color-bg-page: rgb(245 244 239);

    --aw-color-bg-page-dark: rgb(7 15 28);

    ::selection {
      background-color: rgb(201 230 228);
    }
  }

  .dark {
    --aw-font-sans: 'Manrope Variable';
    --aw-font-serif: 'Newsreader';
    --aw-font-heading: 'Newsreader';

    --aw-color-primary: rgb(74 191 197);
    --aw-color-secondary: rgb(114 219 208);
    --aw-color-accent: rgb(233 155 105);

    --aw-color-text-heading: rgb(238 244 247);
    --aw-color-text-default: rgb(222 230 238);
    --aw-color-text-muted: rgb(222 230 238 / 72%);
    --aw-color-bg-page: rgb(7 15 28);

    ::selection {
      background-color: rgb(240 141 84);
      color: rgb(7 15 28);
    }
  }
</style>
