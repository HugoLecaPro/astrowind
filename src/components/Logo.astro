---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-3 self-center whitespace-nowrap">
  <span
    class="relative inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border border-white/60 bg-[radial-gradient(circle_at_30%_30%,rgba(255,255,255,0.98),rgba(157,224,219,0.72)_42%,rgba(13,84,98,0.96)_100%)] shadow-[0_12px_35px_-18px_rgba(10,72,79,0.7)]"
  >
    <span class="h-3 w-3 rounded-full bg-white/90"></span>
    <span class="absolute inset-[6px] rounded-full border border-white/35"></span>
  </span>
  <span class="text-lg md:text-[1.15rem] font-semibold tracking-[-0.03em] text-slate-900 dark:text-white">
    {SITE?.name}
  </span>
</span>
